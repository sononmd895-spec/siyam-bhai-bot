def rol8(val, r):
    """8-bit cyclic bitwise rotation left."""
    return ((val << r) & 0xFF) | ((val & 0xFF) >> (8 - r))

def ror8(val, r):
    """8-bit cyclic bitwise rotation right."""
    return ((val & 0xFF) >> r) | ((val << (8 - r)) & 0xFF)

